# Deploy del bot su VPS (Oracle Cloud Free Tier) — copia questo file sulla VM
# come .env accanto a docker-compose.bot.yml e compila i valori.

# Connessione al database. Strada A: usa la EXTERNAL Database URL del DB Render
# (quella raggiungibile da fuori dalla rete privata di Render, con host .onrender.com).
DATABASE_URL=postgresql://utente:password@host.onrender.com:5432/nome_db

# Token del bot (DOPO averlo rigenerato con BotFather /revoke — quello vecchio è esposto).
TELEGRAM_BOT_TOKEN=123456789:AAAA-rigenerato