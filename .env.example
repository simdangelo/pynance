# Local development: Postgres via Docker Compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_HOST=

# Production (PaaS): a single connection string. When set, it wins over the
# five POSTGRES_* variables above.
DATABASE_URL=

# Production (VPS): the domain Caddy serves and Let's Encrypt validates.
DOMAIN=

# Telegram bot (optional).
TELEGRAM_BOT_TOKEN=

# Production: HTTPS is active, so the session cookie must be Secure.
SECURE_COOKIES=false

# Production: the domain must be accepted by TrustedHostMiddleware.
ALLOWED_HOSTS=["localhost", "127.0.0.1"]